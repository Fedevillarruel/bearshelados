NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose this variable to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical public origin used only by server-side redirects.
SITE_URL=http://localhost:3000
# Tiendanube credentials and the 32-byte base64 token-encryption key are server-side only.
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=
TIENDANUBE_APP_USER_AGENT=BearsHeladosCapacitacion (federico@fedini.app)
TIENDANUBE_TOKEN_ENCRYPTION_KEY=
# At least 32 random characters. Vercel sends it as a Bearer token to cron routes.
CRON_SECRET=
# AI and Meta: server-side only. Set Graph version to a supported version from the Meta app dashboard.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
META_TOKEN_ENCRYPTION_KEY=